<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contact</title>
    <link rel="icon" href="/imgs/fav.png" />
    <link rel="stylesheet" type="text/css" href="styles/contact-styles.css" />
    <link rel="stylesheet" href="/styles/navbar.css" />
    <!-- <script src="js/contact.js" defer></script> -->
    <script src="validation.js" defer></script>
  </head>
  <body>
    <header>
        <%- include('partials/navbar') %>
    </header>
    <main>
      <h1>Contact Form</h1>

      <% if (typeof errors != 'undefined') { %>
        <% errors.forEach(error => { %> 
          <p><%=error%></p>
        <% }); %>
      <% } %>

      <form id="contact-form" action="/submit-submission" method="post">
        <fieldset class="row">
          <div class="field">
            <label for="fname">First Name</label>
            <input type="text" id="fname" name="fname" />
            <span class="err" id="err-fname">First name is required</span>
          </div>

          <div class="field">
            <label for="lname">Last Name</label>
            <input type="text" id="lname" name="lname" />
            <span class="err" id="err-lname">Last name is required</span>
          </div>
          <div class="field">
            <label for="job">Job Title</label>
            <input type="text" id="job" name="job" />
          </div>
        </fieldset>

        <fieldset class="row">
          <div class="field">
            <label for="company">Company</label>
            <input type="text" id="company" name="company" />
          </div>
          <div class="field">
            <label for="linked">LinkedIn URL</label>
            <input type="text" id="linked" name="linked" />
            <span class="err" id="err-linked"
              >Valid LinkedIn URL is required</span
            >
          </div>
          <div class="field">
            <label for="email">Email Address</label>
            <input type="text" id="email" name="email" />
            <span class="err" id="err-email">Valid email is required</span>
          </div>
        </fieldset>

        <fieldset class="row row-2">
          <div class="field">
            <label for="meet">How did we meet?</label>
            <span class="err" id="err-meet">Please select an option</span>
            <select id="meet" name="meet">
              <option value="" disabled selected>Please select</option>
              <option value="linkedin">LinkedIn</option>
              <option value="school">School</option>
              <option value="MinT">MinT</option>
              <option value="event">Event</option>
              <option value="other">Other</option>
            </select>
          </div>
          <div class="field" id="other-field">
            <label for="other">Other (please specify)</label>
            <input type="text" id="other" name="other" />
          </div>
        </fieldset>

        <fieldset>
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5"></textarea>
        </fieldset>

        <fieldset class="mailing-list">
          <label for="mailing-list">
            <input type="checkbox" id="mailing-list" name="mailing-list" />
            Please add me to your mailing list
          </label>
        </fieldset>

        <fieldset class="email-format" id="email-format">
          <label for="html">Choose an email format:</label>
          <label
            ><input type="radio" id="html" name="format" value="html" />
            HTML</label
          >
          <label
            ><input type="radio" id="text" name="format" value="text" /> Text
          </label>
        </fieldset>
        <span class="err" id="err-format">Please select an email format</span>
        <button type="submit">Submit</button>
      </form>
    </main>
  </body>
</html>
